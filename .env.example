# Copy to .env and change the secrets.
POSTGRES_USER=rutest
POSTGRES_PASSWORD=rutest
POSTGRES_DB=rutest
POSTGRES_PORT=5434

# Used by the API when run on the host (make dev-api). Docker Compose overrides the host to "db".
DATABASE_URL=postgres://rutest:rutest@localhost:5434/rutest?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
SEED_SAMPLE_DATA=true
PORT=8081

# Access tokens are short-lived and kept in memory; the refresh token lives in an HttpOnly cookie.
ACCESS_TOKEN_TTL=15m
# Set to true when served over HTTPS.
COOKIE_SECURE=false
