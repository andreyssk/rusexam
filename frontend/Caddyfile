# DOMAIN=example.com -> automatic HTTPS; DOMAIN=:80 -> plain HTTP (IP only)
{$DOMAIN::80} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8081
	}
	handle {
		# Hashed build output never changes; the service worker, manifest and shell must be revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@fresh path /sw.js /manifest.webmanifest /index.html /
		header @fresh Cache-Control "no-cache"
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
